.gitconfig.local


# APM dependencies
apm_modules/

# APM generated skill outputs (外部スキルのみ。`apm install` で再生成する)
.claude/skills/
.agents/skills/

# herdr runtime state (not configuration)
config/herdr/session.json
config/herdr/release-notes.json
config/herdr/.plugins.lock

# tpm-managed tmux plugins
tmux/plugins/

# Karabiner の自動バックアップ (設定ではない)
config/karabiner/automatic_backups/
