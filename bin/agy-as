#!/bin/bash
# イメージ: docker build -t agy-img ~/dotfiles/docker/agy
# 使い方: agy-as [profile] [agy の引数...]。引数なしなら一覧から選ぶ。profile ごとに volume を分けて認証を隔離
set -eu
if [ $# -eq 0 ]; then
  profiles=$(docker volume ls -q --filter name='^agy-' | sed 's/^agy-//')
  PS3='profile: '
  select p in $profiles "(新規作成)"; do [ -n "${p:-}" ] && break; done
  [ "$p" = "(新規作成)" ] && read -rp 'new profile name: ' p
  [ -n "$p" ] || exit 1
else
  p=$1; shift
fi

# ~/bin/agy-as 経由で呼ばれても実体の dotfiles ルートを辿る
script_path=${BASH_SOURCE[0]}
while [ -L "$script_path" ]; do
  script_dir=$(cd -P "$(dirname "$script_path")" && pwd)
  script_path=$(readlink "$script_path")
  [[ "$script_path" != /* ]] && script_path="$script_dir/$script_path"
done
dotfiles_dir=$(cd -P "$(dirname "$script_path")/.." && pwd)

# volume 内の ~/.gemini/config へ直接マウントすると Docker が親ディレクトリを root 所有で作ってしまうため、
# /opt/dotfiles へ read-only で渡し、entrypoint から agy ユーザーで symlink を張る
mounts=(
  -v "agy-$p:/home/agy/.gemini"
  -v "$PWD:/work"
)
[ -d "$HOME/work/skills" ] && mounts+=(-v "$HOME/work/skills:/opt/dotfiles/own-skills:ro")
[ -d "$dotfiles_dir/.agents/skills" ] && mounts+=(-v "$dotfiles_dir/.agents/skills:/opt/dotfiles/ext-skills:ro")
[ -f "$dotfiles_dir/agent-config/AGENTS.md" ] && mounts+=(-v "$dotfiles_dir/agent-config/AGENTS.md:/opt/dotfiles/AGENTS.md:ro")

docker_opts=(-it --rm "${mounts[@]}" -w /work)
entrypoint="$dotfiles_dir/docker/agy/entrypoint.sh"
if [ -x "$entrypoint" ]; then
  docker_opts+=(-v "$entrypoint:/opt/dotfiles/entrypoint.sh:ro" --entrypoint /opt/dotfiles/entrypoint.sh)
fi

# コンテナ内の agy プロセスはホストから見えないため、herdr に前景の docker プロセスを agy として認識させる
export HERDR_AGENT=agy
exec docker run "${docker_opts[@]}" agy-img "$@"
