#!/usr/bin/env python3
import argparse
import datetime as dt
import errno
import json
import os
import signal
import socket
import subprocess
import sys
import time
from pathlib import Path


STATE_DIR = Path(os.environ.get("HERDR_AGENT_STATUS_STATE_DIR", "~/.local/state/herdr")).expanduser()
LOG_PATH = Path(os.environ.get("HERDR_AGENT_STATUS_LOG", STATE_DIR / "agent-status.ndjson")).expanduser()
PID_PATH = STATE_DIR / "agent-status-log.pid"
DAEMON_LOG_PATH = STATE_DIR / "agent-status-log.out"
METADATA_SOURCE = "user:agent-status-log"


def now_iso():
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def ensure_state_dir():
    STATE_DIR.mkdir(parents=True, exist_ok=True)


def run_herdr_agent_list():
    proc = subprocess.run(
        ["herdr", "agent", "list"],
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    payload = json.loads(proc.stdout)
    return payload.get("result", {}).get("agents", [])


def socket_path():
    if os.environ.get("HERDR_SOCKET_PATH"):
        return os.environ["HERDR_SOCKET_PATH"]
    if os.environ.get("HERDR_SESSION"):
        return str(Path("~/.config/herdr/sessions").expanduser() / os.environ["HERDR_SESSION"] / "herdr.sock")
    return str(Path("~/.config/herdr/herdr.sock").expanduser())


def append_record(record):
    ensure_state_dir()
    with LOG_PATH.open("a", encoding="utf-8") as f:
        f.write(json.dumps(record, ensure_ascii=False, sort_keys=True) + "\n")
        f.flush()


def token_time(ts):
    if not ts:
        return ""
    try:
        parsed = dt.datetime.fromisoformat(ts)
    except ValueError:
        return ts[:16]
    return parsed.strftime("%m-%d %H:%M")


def report_status_since(pane_id, agent, status, ts):
    value = token_time(ts)
    if not pane_id or not status or not value:
        return
    subprocess.run(
        [
            "herdr",
            "pane",
            "report-metadata",
            pane_id,
            "--source",
            METADATA_SOURCE,
            "--clear-state-labels",
            "--clear-display-agent",
            "--token",
            f"status_since={value}",
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )


def seed_metadata(agents):
    latest = read_latest_records()
    for agent in agents:
        pane_id = agent.get("pane_id")
        record = latest.get(pane_id or "")
        if record:
            report_status_since(pane_id, agent.get("agent"), record.get("status"), record.get("ts"))
            continue
        ts = now_iso()
        status = agent.get("agent_status")
        append_record(
            {
                "ts": ts,
                "event": "agent_status_observed",
                "pane_id": pane_id,
                "agent": agent.get("agent"),
                "status": status,
                "previous_status": None,
                "workspace_id": agent.get("workspace_id"),
                "tab_id": agent.get("tab_id"),
                "cwd": agent.get("foreground_cwd") or agent.get("cwd"),
                "event_type": "initial_observation",
                "raw": None,
            }
        )
        report_status_since(pane_id, agent.get("agent"), status, ts)


def flatten_dicts(value):
    if isinstance(value, dict):
        yield value
        for child in value.values():
            yield from flatten_dicts(child)
    elif isinstance(value, list):
        for child in value:
            yield from flatten_dicts(child)


def extract_status_event(message):
    for item in flatten_dicts(message):
        pane_id = item.get("pane_id")
        status = item.get("agent_status") or item.get("status") or item.get("state")
        if pane_id and status in {"idle", "working", "blocked", "done", "unknown"}:
            previous = (
                item.get("previous_agent_status")
                or item.get("previous_status")
                or item.get("old_status")
                or item.get("previous_state")
            )
            return {
                "pane_id": pane_id,
                "status": status,
                "previous_status": previous,
                "event_type": item.get("type") or message.get("event") or message.get("type") or message.get("method"),
            }
    return None


def subscribe_once(agents, reconnect_after):
    by_pane = {agent["pane_id"]: agent for agent in agents if agent.get("pane_id")}
    subscriptions = [
        {"type": "pane.agent_status_changed", "pane_id": pane_id}
        for pane_id in sorted(by_pane)
    ]
    if not subscriptions:
        return

    req = {
        "id": f"agent-status-log:{int(time.time())}",
        "method": "events.subscribe",
        "params": {"subscriptions": subscriptions},
    }

    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(reconnect_after)
    sock.connect(socket_path())
    try:
        sock.sendall((json.dumps(req) + "\n").encode("utf-8"))
        reader = sock.makefile("r", encoding="utf-8")
        deadline = time.monotonic() + reconnect_after
        while time.monotonic() < deadline:
            try:
                line = reader.readline()
            except socket.timeout:
                break
            if not line:
                break
            message = json.loads(line)
            if "error" in message:
                raise RuntimeError(message["error"])
            event = extract_status_event(message)
            if not event:
                continue
            agent = by_pane.get(event["pane_id"], {})
            ts = now_iso()
            append_record(
                {
                    "ts": ts,
                    "event": "agent_status_changed",
                    "pane_id": event["pane_id"],
                    "agent": agent.get("agent"),
                    "status": event["status"],
                    "previous_status": event["previous_status"],
                    "workspace_id": agent.get("workspace_id"),
                    "tab_id": agent.get("tab_id"),
                    "cwd": agent.get("foreground_cwd") or agent.get("cwd"),
                    "event_type": event["event_type"],
                    "raw": message,
                }
            )
            report_status_since(event["pane_id"], agent.get("agent"), event["status"], ts)
    finally:
        sock.close()


def cmd_watch(args):
    ensure_state_dir()
    while True:
        try:
            agents = run_herdr_agent_list()
            seed_metadata(agents)
            subscribe_once(agents, args.refresh_seconds)
        except KeyboardInterrupt:
            return 130
        except Exception as exc:
            print(f"{now_iso()} herdr-agent-status-log: {exc}", file=sys.stderr, flush=True)
            time.sleep(args.retry_seconds)


def read_latest_records():
    latest = {}
    if not LOG_PATH.exists():
        return latest
    with LOG_PATH.open(encoding="utf-8") as f:
        for line in f:
            try:
                record = json.loads(line)
            except json.JSONDecodeError:
                continue
            pane_id = record.get("pane_id")
            if pane_id:
                latest[pane_id] = record
    return latest


def short_cwd(path):
    if not path:
        return ""
    home = str(Path.home())
    if path == home:
        return "~"
    if path.startswith(home + "/"):
        return "~/" + path[len(home) + 1 :]
    return path


def cmd_show(args):
    agents = run_herdr_agent_list()
    latest = read_latest_records()

    rows = []
    for agent in agents:
        pane_id = agent.get("pane_id", "")
        record = latest.get(pane_id, {})
        rows.append(
            {
                "last": record.get("ts", ""),
                "status": agent.get("agent_status", ""),
                "agent": agent.get("agent", ""),
                "pane": pane_id,
                "cwd": short_cwd(agent.get("foreground_cwd") or agent.get("cwd")),
            }
        )

    rows.sort(key=lambda row: row["last"] or "0000", reverse=not args.oldest_first)
    print(f"{'LAST_CHANGE':<25} {'STATUS':<8} {'AGENT':<8} {'PANE':<7} CWD")
    for row in rows:
        print(
            f"{(row['last'] or '-'): <25} "
            f"{row['status']:<8} "
            f"{row['agent']:<8} "
            f"{row['pane']:<7} "
            f"{row['cwd']}"
        )
    if not LOG_PATH.exists():
        print(f"\nNo log yet: {LOG_PATH}", file=sys.stderr)
    return 0


def cmd_tail(args):
    ensure_state_dir()
    LOG_PATH.touch(exist_ok=True)
    proc = subprocess.run(["tail", "-n", str(args.lines), "-f", str(LOG_PATH)])
    return proc.returncode


def pid_is_running(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError as exc:
        return exc.errno == errno.EPERM


def read_pid():
    try:
        return int(PID_PATH.read_text(encoding="utf-8").strip())
    except Exception:
        return None


def cmd_start(_args):
    ensure_state_dir()
    pid = read_pid()
    if pid and pid_is_running(pid):
        print(f"already running: pid {pid}")
        return 0
    out = DAEMON_LOG_PATH.open("a", encoding="utf-8")
    proc = subprocess.Popen(
        [sys.argv[0], "watch"],
        stdout=out,
        stderr=out,
        stdin=subprocess.DEVNULL,
        start_new_session=True,
    )
    PID_PATH.write_text(str(proc.pid), encoding="utf-8")
    print(f"started: pid {proc.pid}")
    print(f"log: {LOG_PATH}")
    return 0


def cmd_stop(_args):
    pid = read_pid()
    if not pid or not pid_is_running(pid):
        print("not running")
        return 0
    os.kill(pid, signal.SIGTERM)
    print(f"stopped: pid {pid}")
    return 0


def cmd_status(_args):
    pid = read_pid()
    if pid and pid_is_running(pid):
        print(f"running: pid {pid}")
    else:
        print("not running")
    print(f"log: {LOG_PATH}")
    return 0


def build_parser():
    parser = argparse.ArgumentParser(description="Record and inspect Herdr agent status changes.")
    sub = parser.add_subparsers(dest="command", required=True)

    watch = sub.add_parser("watch", help="Subscribe to Herdr status changes and append NDJSON logs.")
    watch.add_argument("--refresh-seconds", type=int, default=30, help="Reconnect periodically to pick up new panes.")
    watch.add_argument("--retry-seconds", type=int, default=5, help="Delay after connection or command failures.")
    watch.set_defaults(func=cmd_watch)

    show = sub.add_parser("show", help="Show current agents sorted by last logged status change.")
    show.add_argument("--oldest-first", action="store_true", help="Sort oldest status changes first.")
    show.set_defaults(func=cmd_show)

    tail = sub.add_parser("tail", help="Follow the raw NDJSON status log.")
    tail.add_argument("-n", "--lines", type=int, default=20)
    tail.set_defaults(func=cmd_tail)

    sub.add_parser("start", help="Start the logger in the background.").set_defaults(func=cmd_start)
    sub.add_parser("stop", help="Stop the background logger.").set_defaults(func=cmd_stop)
    sub.add_parser("status", help="Show background logger status.").set_defaults(func=cmd_status)
    return parser


def main():
    parser = build_parser()
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
